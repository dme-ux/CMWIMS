# ---------------------------------------------------------------------------
# CMW ERP — Environment Variables
# Copy to `.env` and fill in real values.
# ---------------------------------------------------------------------------

# PostgreSQL connection (Supabase recommended)
# --- Supabase: Dashboard → Connect → ORM tab → Prisma ---
# DATABASE_URL = Transaction pooler (port 6543), used by the app at runtime
# DIRECT_URL   = Session/Direct connection (port 5432), used for migrations
DATABASE_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true"
DIRECT_URL="postgres://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# On Neon / Railway / local Postgres you can set both to the same value:
# DATABASE_URL="postgresql://user:password@host:5432/cmw_erp?schema=public"
# DIRECT_URL="postgresql://user:password@host:5432/cmw_erp?schema=public"

# JWT signing secret — generate with:  openssl rand -base64 48
JWT_SECRET="replace-with-a-long-random-secret"

# App URL (used in emails / links)
NEXT_PUBLIC_APP_URL="http://localhost:3000"

# --- Google Sheets Live Sync (optional, set from Settings UI too) ---
GOOGLE_SHEET_ID=""
GOOGLE_APPS_SCRIPT_URL=""
GOOGLE_SYNC_API_KEY=""
